{
  "name": "@prime-agent/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node bridge sidecar — owns the daemon connection and exposes the JSON-RPC IPC contract to the Rust shell.",
  "type": "module",
  "main": "./dist/bridge/src/index.js",
  "types": "./dist/bridge/src/index.d.ts",
  "bin": {
    "prime-agent-bridge": "./dist/bridge/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "shx rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:settings": "npm run build && node verify-settings.mjs",
    "verify:lifecycle": "npm run build && node verify-lifecycle.mjs",
    "test:kernel-compat": "npm run build && node --test verify-kernel-state-compat.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../.deps/prime-agent/packages/agent",
    "@earendil-works/pi-ai": "file:../.deps/prime-agent/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../.deps/prime-agent/packages/coding-agent",
    "@earendil-works/pi-tui": "file:../.deps/prime-agent/packages/tui"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.0"
  }
}
