{
  "name": "sophos",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "Sophos — a Windows-native port of Prime Intellect's Prime Agent. Credits: PrimeIntellect-ai/prime-agent (upstream).",
  "scripts": {
    "dev": "vite",
    "test": "vitest run && node --test verify/cua/thread-visibility.node-test.mjs verify/cua/driver.test.mjs verify/cua/inbox-import.test.mjs verify/live-feed-download.test.mjs bridge/session-recovery-readiness.test.mjs bridge/recovery-probe.test.mjs bridge/verify.test.mjs bridge/verify-lifecycle.test.mjs bridge/lifecycle-cancellation.test.mjs verify/live-bounded-spend-test.test.mjs verify/e2e-mock-provider.test.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bridge:build": "cd bridge && npm run build",
    "bridge:verify": "node bridge/verify.mjs",
    "bridge:verify:concurrent": "node bridge/verify-concurrency.mjs",
    "bridge:dev": "cd bridge && npm run dev",
    "test:visual": "node verify/visual/regression.mjs",
    "test:visual:update": "node verify/visual/snapshot.mjs",
    "verify:safety": "node verify/e2e-safety.mjs",
    "updater:keys": "node scripts/gen-updater-keys.mjs",
    "updater:serve": "node scripts/serve-update-feed.mjs",
    "updater:build": "node scripts/build-signed-update.mjs",
    "test:updater": "node verify/updater-test.mjs",
    "test:live-feed": "node verify/live-feed.mjs",
    "test:cua": "node verify/cua/run-all.mjs",
    "lint": "eslint src bridge/src --max-warnings 0",
    "lint:fix": "eslint src bridge/src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"bridge/src/**/*.ts\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"bridge/src/**/*.ts\" \"*.{ts,mjs,json}\"",
    "check": "npm run lint && npm run format:check && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "framer-motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
